  @@index([userId], map: "user_activation_tokens_user_id_idx")
  @@index([expiresAt], map: "user_activation_tokens_expires_at_idx")
  @@index([consumedAt], map: "user_activation_tokens_consumed_at_idx")
  @@index([invalidatedAt], map: "user_activation_tokens_invalidated_at_idx")
  @@map("user_activation_tokens")
}

model LoginChallenge {
