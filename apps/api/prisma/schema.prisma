generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("organization_status")
}

enum FacilityType {
  INTERNATIONAL_WAREHOUSE
  DISTRIBUTION_CENTER
  BRANCH
  AGENCY
  PICKUP_POINT
  OFFICE
  CUSTOMS_WAREHOUSE

  @@map("facility_type")
}

enum FacilityOwnershipType {
  OWNED
  AGENCY
  PARTNER

  @@map("facility_ownership_type")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum EmployeeStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED

  @@map("employee_status")
}

enum SessionRevocationReason {
  LOGOUT
  ROTATED
  REUSE_DETECTED
  IDLE_TIMEOUT
  ADMIN_REVOKED
  ACCOUNT_CHANGED

  @@map("session_revocation_reason")
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS

  @@map("customer_type")
}

enum CustomerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("customer_status")
}

enum CustomerAddressType {
  HOME
  WORK
  BILLING
  DELIVERY
  OTHER

  @@map("customer_address_type")
}

enum CustomerIdentityDocumentType {
  CEDULA
  PASSPORT
  RNC

  @@map("customer_identity_document_type")
}

enum CustomsRegistrationStatus {
  UNKNOWN
  PENDING
  REGISTERED
  NOT_REGISTERED
  VERIFICATION_FAILED

  @@map("customs_registration_status")
}

enum CustomsVerificationSource {
  MANUAL
  DGA_PORTAL
  OFFICIAL_INTEGRATION

  @@map("customs_verification_source")
}

enum CustomerCodeStrategy {
  AUTO_RANDOM
  AUTO_SEQUENTIAL

  @@map("customer_code_strategy")
}

enum WeightUnit {
  LB
  KG

  @@map("weight_unit")
}

enum DimensionUnit {
  IN
  CM

  @@map("dimension_unit")
}

enum DateDisplayFormat {
  DMY
  MDY
  YMD

  @@map("date_display_format")
}

enum CustomerImportJobStatus {
  DRAFT
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED

  @@map("customer_import_job_status")
}

enum CustomerImportRowStatus {
  PENDING
  VALID
  INVALID
  IMPORTED

  @@map("customer_import_row_status")
}

enum AuditActorType {
  EMPLOYEE
  SYSTEM
  INTEGRATION

  @@map("audit_actor_type")
}

enum AuditSource {
  HTTP
  JOB
  IMPORT
  SYSTEM

  @@map("audit_source")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER

  @@map("outbox_event_status")
}

enum PrealertStatus {
  PENDING_ARRIVAL
  MATCHED
  CANCELLED

  @@map("prealert_status")
}

enum PrealertInvoiceStatus {
  NOT_REQUIRED
  PENDING
  PROVIDED
  REJECTED
  VERIFIED

  @@map("prealert_invoice_status")
}

enum PackageStatus {
  RECEPTION_PENDING
  RECEIVED_AT_ORIGIN
  CANCELLED

  @@map("package_status")
}

enum PackageCondition {
  SEALED
  OPEN
  DAMAGED
  WET
  CRUSHED
  OTHER

  @@map("package_condition")
}

enum PackageDocumentType {
  INVOICE
  PURCHASE_RECEIPT
  PACKAGE_PHOTO
  DAMAGE_PHOTO
  IDENTITY_SUPPORT
  OTHER

  @@map("package_document_type")
}

enum StoredObjectStatus {
  PENDING_UPLOAD
  AVAILABLE
  QUARANTINED
  DELETED

  @@map("stored_object_status")
}

enum WarehouseLocationType {
  RECEIVING
  SHELF
  RACK
  BIN
  STAGING
  HOLD
  DISPATCH

  @@map("warehouse_location_type")
}

enum InventoryMovementType {
  PUTAWAY
  MOVE
  HOLD
  RELEASE
  REMOVE

  @@map("inventory_movement_type")
}

model Organization {
  id                        String                     @id(map: "organizations_pkey") @default(uuid()) @db.Uuid
  legalName                 String                     @map("legal_name") @db.VarChar(200)
  commercialName            String                     @map("commercial_name") @db.VarChar(120)
  slug                      String                     @unique(map: "organizations_slug_key") @db.VarChar(80)
  rnc                       String?                    @db.VarChar(20)
  email                     String?                    @db.VarChar(320)
  phone                     String?                    @db.VarChar(32)
  countryCode               String                     @default("DO") @map("country_code") @db.Char(2)
  currencyCode              String                     @default("DOP") @map("currency_code") @db.Char(3)
  timezone                  String                     @default("America/Santo_Domingo") @db.VarChar(64)
  status                    OrganizationStatus         @default(TRIAL)
  planCode                  String                     @default("PILOT") @map("plan_code") @db.VarChar(40)
  maxUsers                  Int                        @default(5) @map("max_users")
  maxFacilities             Int                        @default(2) @map("max_facilities")
  trialEndsAt               DateTime?                  @map("trial_ends_at") @db.Timestamptz(3)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                 DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  facilities                Facility[]
  customers                 Customer[]
  customerAddresses         CustomerAddress[]
  customerCustomsProfiles   CustomerCustomsProfile[]
  employees                 Employee[]
  employeeFacilities        EmployeeFacility[]
  roles                     Role[]
  employeeRoles             EmployeeRole[]
  rolePermissions           RolePermission[]
  userSessions              UserSession[]
  settings                  OrganizationSettings?
  customerImportJobs        CustomerImportJob[]
  customerImportRows        CustomerImportRow[]
  auditLogs                 AuditLog[]
  outboxEvents              OutboxEvent[]
  prealerts                 Prealert[]
  packages                  Package[]
  packageReceptions         PackageReception[]
  storedObjects             StoredObject[]
  packageDocuments          PackageDocument[]
  warehouseLocations        WarehouseLocation[]
  packageInventoryPositions PackageInventoryPosition[]
  inventoryMovements        InventoryMovement[]

  @@index([status], map: "organizations_status_idx")
  @@index([deletedAt], map: "organizations_deleted_at_idx")
  @@map("organizations")
}

model AuditLog {
  id              String         @id(map: "audit_logs_pkey") @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  actorType       AuditActorType @map("actor_type")
  actorUserId     String?        @map("actor_user_id") @db.Uuid
  actorEmployeeId String?        @map("actor_employee_id") @db.Uuid
  action          String         @db.VarChar(120)
  entityType      String         @map("entity_type") @db.VarChar(80)
  entityId        String         @map("entity_id") @db.VarChar(128)
  source          AuditSource
  requestId       String         @map("request_id") @db.Uuid
  correlationId   String         @map("correlation_id") @db.VarChar(100)
  changedFields   Json           @map("changed_fields")
  beforeData      Json?          @map("before_data")
  afterData       Json?          @map("after_data")
  reason          String?        @db.VarChar(500)
  metadata        Json?
  ipAddress       String?        @map("ip_address") @db.VarChar(64)
  userAgent       String?        @map("user_agent") @db.VarChar(512)
  occurredAt      DateTime       @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "audit_logs_organization_id_fkey")

  @@index([organizationId, occurredAt], map: "audit_logs_organization_id_occurred_at_idx")
  @@index([organizationId, entityType, entityId, occurredAt], map: "audit_logs_org_entity_occurred_at_idx")
  @@index([organizationId, actorEmployeeId, occurredAt], map: "audit_logs_org_actor_occurred_at_idx")
  @@index([organizationId, action, occurredAt], map: "audit_logs_org_action_occurred_at_idx")
  @@index([organizationId, correlationId], map: "audit_logs_org_correlation_id_idx")
  @@map("audit_logs")
}

model OutboxEvent {
  id                  String            @id(map: "outbox_events_pkey") @default(uuid()) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  eventType           String            @map("event_type") @db.VarChar(120)
  aggregateType       String            @map("aggregate_type") @db.VarChar(80)
  aggregateId         String            @map("aggregate_id") @db.VarChar(128)
  schemaVersion       Int               @map("schema_version")
  payload             Json
  metadata            Json?
  idempotencyKey      String            @map("idempotency_key") @db.VarChar(200)
  status              OutboxEventStatus @default(PENDING)
  occurredAt          DateTime          @map("occurred_at") @db.Timestamptz(3)
  availableAt         DateTime          @map("available_at") @db.Timestamptz(3)
  lockedBy            String?           @map("locked_by") @db.VarChar(120)
  lockedUntil         DateTime?         @map("locked_until") @db.Timestamptz(3)
  attempts            Int               @default(0)
  processingStartedAt DateTime?         @map("processing_started_at") @db.Timestamptz(3)
  publishedAt         DateTime?         @map("published_at") @db.Timestamptz(3)
  deadLetteredAt      DateTime?         @map("dead_lettered_at") @db.Timestamptz(3)
  lastErrorCode       String?           @map("last_error_code") @db.VarChar(120)
  lastErrorAt         DateTime?         @map("last_error_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "outbox_events_organization_id_fkey")

  @@unique([organizationId, idempotencyKey], map: "outbox_events_organization_id_idempotency_key_key")
  @@index([status, availableAt, createdAt], map: "outbox_events_status_available_at_created_at_idx")
  @@index([organizationId, aggregateType, aggregateId], map: "outbox_events_org_aggregate_idx")
  @@index([organizationId, occurredAt], map: "outbox_events_organization_id_occurred_at_idx")
  @@map("outbox_events")
}

model Facility {
  id                        String                     @id(map: "facilities_pkey") @default(uuid()) @db.Uuid
  organizationId            String                     @map("organization_id") @db.Uuid
  code                      String                     @db.VarChar(40)
  name                      String                     @db.VarChar(120)
  type                      FacilityType
  ownershipType             FacilityOwnershipType      @default(OWNED) @map("ownership_type")
  countryCode               String                     @default("DO") @map("country_code") @db.Char(2)
  province                  String?                    @db.VarChar(80)
  city                      String?                    @db.VarChar(80)
  addressLine1              String?                    @map("address_line_1") @db.VarChar(200)
  addressLine2              String?                    @map("address_line_2") @db.VarChar(200)
  phone                     String?                    @db.VarChar(32)
  email                     String?                    @db.VarChar(320)
  isCustomerFacing          Boolean                    @default(true) @map("is_customer_facing")
  isPackageOrigin           Boolean                    @default(false) @map("is_package_origin")
  isDistributionCenter      Boolean                    @default(false) @map("is_distribution_center")
  isActive                  Boolean                    @default(true) @map("is_active")
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                 DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "facilities_organization_id_fkey")
  employeeFacilities        EmployeeFacility[]
  packageReceptions         PackageReception[]
  warehouseLocations        WarehouseLocation[]
  packageInventoryPositions PackageInventoryPosition[]
  inventoryMovements        InventoryMovement[]

  @@unique([organizationId, code], map: "facilities_organization_id_code_key")
  @@unique([organizationId, id], map: "facilities_organization_id_id_key")
  @@index([organizationId, type], map: "facilities_organization_id_type_idx")
  @@index([organizationId, isActive], map: "facilities_organization_id_is_active_idx")
  @@index([organizationId, deletedAt], map: "facilities_organization_id_deleted_at_idx")
  @@map("facilities")
}

model Customer {
  id             String                  @id(map: "customers_pkey") @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  customerCode   String                  @map("customer_code") @db.VarChar(40)
  type           CustomerType
  firstName      String?                 @map("first_name") @db.VarChar(120)
  lastName       String?                 @map("last_name") @db.VarChar(120)
  businessName   String?                 @map("business_name") @db.VarChar(200)
  email          String?                 @db.VarChar(320)
  phone          String?                 @db.VarChar(32)
  mobilePhone    String?                 @map("mobile_phone") @db.VarChar(32)
  status         CustomerStatus          @default(PENDING)
  notes          String?                 @db.VarChar(1000)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?               @map("deleted_at") @db.Timestamptz(3)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "customers_organization_id_fkey")
  addresses      CustomerAddress[]
  customsProfile CustomerCustomsProfile?
  importRows     CustomerImportRow[]
  prealerts      Prealert[]
  packages       Package[]

  @@unique([organizationId, customerCode], map: "customers_organization_id_customer_code_key")
  @@unique([organizationId, id], map: "customers_organization_id_id_key")
  @@index([organizationId, status], map: "customers_organization_id_status_idx")
  @@index([organizationId, type], map: "customers_organization_id_type_idx")
  @@index([organizationId, deletedAt], map: "customers_organization_id_deleted_at_idx")
  @@map("customers")
}

model OrganizationSettings {
  organizationId              String               @id(map: "organization_settings_pkey") @map("organization_id") @db.Uuid
  locale                      String               @default("es-DO") @db.VarChar(10)
  dateFormat                  DateDisplayFormat    @default(DMY) @map("date_format")
  weightUnit                  WeightUnit           @default(LB) @map("weight_unit")
  dimensionUnit               DimensionUnit        @default(IN) @map("dimension_unit")
  customerCodeStrategy        CustomerCodeStrategy @default(AUTO_RANDOM) @map("customer_code_strategy")
  customerCodePrefix          String               @default("C") @map("customer_code_prefix") @db.VarChar(8)
  customerCodeRandomLength    Int                  @default(8) @map("customer_code_random_length")
  customerCodeSequencePadding Int                  @default(6) @map("customer_code_sequence_padding")
  nextCustomerSequence        BigInt               @default(1) @map("next_customer_sequence") @db.BigInt
  onboardingCompletedAt       DateTime?            @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization                Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_settings_organization_id_fkey")

  @@map("organization_settings")
}

model CustomerImportJob {
  id                    String                  @id(map: "customer_import_jobs_pkey") @default(uuid()) @db.Uuid
  organizationId        String                  @map("organization_id") @db.Uuid
  createdByEmployeeId   String                  @map("created_by_employee_id") @db.Uuid
  name                  String?                 @db.VarChar(160)
  status                CustomerImportJobStatus
  preserveCustomerCodes Boolean                 @default(false) @map("preserve_customer_codes")
  totalRows             Int                     @default(0) @map("total_rows")
  validRows             Int                     @default(0) @map("valid_rows")
  invalidRows           Int                     @default(0) @map("invalid_rows")
  importedRows          Int                     @default(0) @map("imported_rows")
  validationSummary     Json?                   @map("validation_summary")
  failureCode           String?                 @map("failure_code") @db.VarChar(80)
  validatedAt           DateTime?               @map("validated_at") @db.Timestamptz(3)
  startedAt             DateTime?               @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?               @map("completed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?               @map("cancelled_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "customer_import_jobs_organization_id_fkey")
  createdByEmployee     Employee                @relation(fields: [organizationId, createdByEmployeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "customer_import_jobs_created_by_employee_fkey")
  rows                  CustomerImportRow[]

  @@unique([organizationId, id], map: "customer_import_jobs_organization_id_id_key")
  @@index([organizationId, status], map: "customer_import_jobs_organization_id_status_idx")
  @@index([organizationId, createdByEmployeeId], map: "customer_import_jobs_organization_id_created_by_employee_id_idx")
  @@map("customer_import_jobs")
}

model CustomerImportRow {
  id                 String                  @id(map: "customer_import_rows_pkey") @default(uuid()) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  importJobId        String                  @map("import_job_id") @db.Uuid
  rowNumber          Int                     @map("row_number")
  rawData            Json                    @map("raw_data")
  normalizedData     Json?                   @map("normalized_data")
  status             CustomerImportRowStatus @default(PENDING)
  validationErrors   Json?                   @map("validation_errors")
  importedCustomerId String?                 @map("imported_customer_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "customer_import_rows_organization_id_fkey")
  importJob          CustomerImportJob       @relation(fields: [organizationId, importJobId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "customer_import_rows_organization_id_import_job_id_fkey")
  importedCustomer   Customer?               @relation(fields: [organizationId, importedCustomerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "customer_import_rows_organization_id_imported_customer_id_fkey")

  @@unique([organizationId, importJobId, rowNumber], map: "customer_import_rows_org_job_row_key")
  @@index([organizationId, importJobId], map: "customer_import_rows_organization_id_import_job_id_idx")
  @@index([organizationId, status], map: "customer_import_rows_organization_id_status_idx")
  @@index([organizationId, importedCustomerId], map: "customer_import_rows_organization_id_imported_customer_id_idx")
  @@map("customer_import_rows")
}

model CustomerAddress {
  id             String              @id(map: "customer_addresses_pkey") @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  customerId     String              @map("customer_id") @db.Uuid
  type           CustomerAddressType
  label          String?             @db.VarChar(120)
  recipientName  String?             @map("recipient_name") @db.VarChar(160)
  phone          String?             @db.VarChar(32)
  addressLine1   String              @map("address_line_1") @db.VarChar(200)
  addressLine2   String?             @map("address_line_2") @db.VarChar(200)
  city           String              @db.VarChar(80)
  province       String              @db.VarChar(80)
  postalCode     String?             @map("postal_code") @db.VarChar(32)
  countryCode    String              @default("DO") @map("country_code") @db.Char(2)
  isPrimary      Boolean             @default(false) @map("is_primary")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz(3)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "customer_addresses_organization_id_fkey")
  customer       Customer            @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "customer_addresses_organization_id_customer_id_fkey")

  @@unique([organizationId, id], map: "customer_addresses_organization_id_id_key")
  @@index([organizationId, customerId], map: "customer_addresses_organization_id_customer_id_idx")
  @@index([organizationId, customerId, type], map: "customer_addresses_organization_id_customer_id_type_idx")
  @@index([organizationId, deletedAt], map: "customer_addresses_organization_id_deleted_at_idx")
  @@map("customer_addresses")
}

model CustomerCustomsProfile {
  id                 String                       @id(map: "customer_customs_profiles_pkey") @default(uuid()) @db.Uuid
  organizationId     String                       @map("organization_id") @db.Uuid
  customerId         String                       @map("customer_id") @db.Uuid
  documentType       CustomerIdentityDocumentType @map("document_type")
  documentNumber     String                       @map("document_number") @db.VarChar(30)
  ruaStatus          CustomsRegistrationStatus    @default(UNKNOWN) @map("rua_status")
  verificationSource CustomsVerificationSource?   @map("verification_source")
  lastCheckedAt      DateTime?                    @map("last_checked_at") @db.Timestamptz(3)
  verifiedAt         DateTime?                    @map("verified_at") @db.Timestamptz(3)
  externalReference  String?                      @map("external_reference") @db.VarChar(120)
  notes              String?                      @db.VarChar(1000)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "customer_customs_profiles_organization_id_fkey")
  customer           Customer                     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "customer_customs_profiles_organization_id_customer_id_fkey")

  @@unique([organizationId, customerId], map: "customer_customs_profiles_organization_id_customer_id_key")
  @@unique([organizationId, documentType, documentNumber], map: "customer_customs_profiles_org_doc_key")
  @@unique([organizationId, id], map: "customer_customs_profiles_organization_id_id_key")
  @@index([organizationId, ruaStatus], map: "customer_customs_profiles_organization_id_rua_status_idx")
  @@map("customer_customs_profiles")
}

model User {
  id                  String                @id(map: "users_pkey") @default(uuid()) @db.Uuid
  email               String                @unique(map: "users_email_key") @db.VarChar(320)
  passwordHash        String?               @map("password_hash") @db.VarChar(255)
  passwordChangedAt   DateTime?             @map("password_changed_at") @db.Timestamptz(3)
  emailVerifiedAt     DateTime?             @map("email_verified_at") @db.Timestamptz(3)
  status              UserStatus            @default(INVITED)
  failedLoginAttempts Int                   @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?             @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?             @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?             @map("deleted_at") @db.Timestamptz(3)
  employees           Employee[]
  activationTokens    UserActivationToken[]
  loginChallenges     LoginChallenge[]

  @@index([status], map: "users_status_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
