model FacilityTransfer {
  id                    String                 @id(map: "facility_transfers_pkey") @default(uuid()) @db.Uuid
  organizationId        String                 @map("organization_id") @db.Uuid
  transferNumber        String                 @map("transfer_number") @db.VarChar(40)
  originFacilityId      String                 @map("origin_facility_id") @db.Uuid
  destinationFacilityId String                 @map("destination_facility_id") @db.Uuid
  status                FacilityTransferStatus @default(DRAFT)
  notes                 String?                @db.VarChar(1000)
  vehicleInfo           String?                @map("vehicle_info") @db.VarChar(200)
  dispatchedAt          DateTime?              @map("dispatched_at") @db.Timestamptz(3)
  receivedAt            DateTime?              @map("received_at") @db.Timestamptz(3)
  createdById           String                 @map("created_by_id") @db.Uuid
  dispatchedById        String?                @map("dispatched_by_id") @db.Uuid
  receivedById          String?                @map("received_by_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "facility_transfers_org_id_fkey")
  originFacility      Facility                @relation("TransferOriginFacility", fields: [organizationId, originFacilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "facility_transfers_org_origin_facility_fkey")
  destinationFacility Facility                @relation("TransferDestinationFacility", fields: [organizationId, destinationFacilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "facility_transfers_org_destination_facility_fkey")
  createdBy           Employee                @relation("TransferCreatedByEmployee", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "facility_transfers_created_by_fkey")
  dispatchedBy        Employee?               @relation("TransferDispatchedByEmployee", fields: [organizationId, dispatchedById], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "facility_transfers_dispatched_by_fkey")
  receivedBy          Employee?               @relation("TransferReceivedByEmployee", fields: [organizationId, receivedById], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "facility_transfers_received_by_fkey")
  items               FacilityTransferItem[]
  events              FacilityTransferEvent[]

  @@unique([organizationId, transferNumber], map: "facility_transfers_org_transfer_number_key")
  @@unique([organizationId, id], map: "facility_transfers_org_id_key")
  @@index([organizationId, originFacilityId, status], map: "facility_transfers_org_origin_status_idx")
  @@index([organizationId, destinationFacilityId, status], map: "facility_transfers_org_destination_status_idx")
  @@map("facility_transfers")
}

model FacilityTransferItem {
  id             String                     @id(map: "facility_transfer_items_pkey") @default(uuid()) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  transferId     String                     @map("transfer_id") @db.Uuid
  packageId      String                     @map("package_id") @db.Uuid
  status         FacilityTransferItemStatus @default(PENDING)
  notes          String?                    @db.VarChar(500)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "facility_transfer_items_org_id_fkey")
  transfer     FacilityTransfer @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade, map: "facility_transfer_items_org_transfer_id_fkey")
  package      Package          @relation(fields: [organizationId, packageId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "facility_transfer_items_org_package_id_fkey")

  @@unique([organizationId, transferId, packageId], map: "facility_transfer_items_org_transfer_package_key")
  @@unique([organizationId, id], map: "facility_transfer_items_org_id_key")
  @@map("facility_transfer_items")
}

model FacilityTransferEvent {
  id             String                    @id(map: "facility_transfer_events_pkey") @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  transferId     String                    @map("transfer_id") @db.Uuid
  eventType      FacilityTransferEventType @map("event_type")
  notes          String?                   @db.VarChar(500)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "facility_transfer_events_org_id_fkey")
  transfer     FacilityTransfer @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade, map: "facility_transfer_events_org_transfer_id_fkey")

  @@unique([organizationId, id], map: "facility_transfer_events_org_id_key")
  @@index([organizationId, transferId, createdAt], map: "facility_transfer_events_org_transfer_created_idx")
  @@map("facility_transfer_events")
}

