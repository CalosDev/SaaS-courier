generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("organization_status")
}

enum FacilityType {
  INTERNATIONAL_WAREHOUSE
  DISTRIBUTION_CENTER
  BRANCH
  AGENCY
  PICKUP_POINT
  OFFICE
  CUSTOMS_WAREHOUSE

  @@map("facility_type")
}

enum FacilityOwnershipType {
  OWNED
  AGENCY
  PARTNER

  @@map("facility_ownership_type")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum EmployeeStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED

  @@map("employee_status")
}

enum SessionRevocationReason {
  LOGOUT
  ROTATED
  REUSE_DETECTED
  IDLE_TIMEOUT
  ADMIN_REVOKED
  ACCOUNT_CHANGED

  @@map("session_revocation_reason")
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS

  @@map("customer_type")
}

enum CustomerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("customer_status")
}

enum CustomerAddressType {
  HOME
  WORK
  BILLING
  DELIVERY
  OTHER

  @@map("customer_address_type")
}

enum CustomerIdentityDocumentType {
  CEDULA
  PASSPORT
  RNC

  @@map("customer_identity_document_type")
}

enum CustomsRegistrationStatus {
  UNKNOWN
  PENDING
  REGISTERED
  NOT_REGISTERED
  VERIFICATION_FAILED

  @@map("customs_registration_status")
}

enum CustomsVerificationSource {
  MANUAL
  DGA_PORTAL
  OFFICIAL_INTEGRATION

  @@map("customs_verification_source")
}

model Organization {
  id                      String                   @id(map: "organizations_pkey") @default(uuid()) @db.Uuid
  legalName               String                   @map("legal_name") @db.VarChar(200)
  commercialName          String                   @map("commercial_name") @db.VarChar(120)
  slug                    String                   @unique(map: "organizations_slug_key") @db.VarChar(80)
  rnc                     String?                  @db.VarChar(20)
  email                   String?                  @db.VarChar(320)
  phone                   String?                  @db.VarChar(32)
  countryCode             String                   @default("DO") @map("country_code") @db.Char(2)
  currencyCode            String                   @default("DOP") @map("currency_code") @db.Char(3)
  timezone                String                   @default("America/Santo_Domingo") @db.VarChar(64)
  status                  OrganizationStatus       @default(TRIAL)
  planCode                String                   @default("PILOT") @map("plan_code") @db.VarChar(40)
  maxUsers                Int                      @default(5) @map("max_users")
  maxFacilities           Int                      @default(2) @map("max_facilities")
  trialEndsAt             DateTime?                @map("trial_ends_at") @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz(3)
  facilities              Facility[]
  customers               Customer[]
  customerAddresses       CustomerAddress[]
  customerCustomsProfiles CustomerCustomsProfile[]
  employees               Employee[]
  employeeFacilities      EmployeeFacility[]
  roles                   Role[]
  employeeRoles           EmployeeRole[]
  rolePermissions         RolePermission[]
  userSessions            UserSession[]

  @@index([status], map: "organizations_status_idx")
  @@index([deletedAt], map: "organizations_deleted_at_idx")
  @@map("organizations")
}

model Facility {
  id                   String                @id(map: "facilities_pkey") @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  code                 String                @db.VarChar(40)
  name                 String                @db.VarChar(120)
  type                 FacilityType
  ownershipType        FacilityOwnershipType @default(OWNED) @map("ownership_type")
  countryCode          String                @default("DO") @map("country_code") @db.Char(2)
  province             String?               @db.VarChar(80)
  city                 String?               @db.VarChar(80)
  addressLine1         String?               @map("address_line_1") @db.VarChar(200)
  addressLine2         String?               @map("address_line_2") @db.VarChar(200)
  phone                String?               @db.VarChar(32)
  email                String?               @db.VarChar(320)
  isCustomerFacing     Boolean               @default(true) @map("is_customer_facing")
  isPackageOrigin      Boolean               @default(false) @map("is_package_origin")
  isDistributionCenter Boolean               @default(false) @map("is_distribution_center")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(3)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "facilities_organization_id_fkey")
  employeeFacilities   EmployeeFacility[]

  @@unique([organizationId, code], map: "facilities_organization_id_code_key")
  @@unique([organizationId, id], map: "facilities_organization_id_id_key")
  @@index([organizationId, type], map: "facilities_organization_id_type_idx")
  @@index([organizationId, isActive], map: "facilities_organization_id_is_active_idx")
  @@index([organizationId, deletedAt], map: "facilities_organization_id_deleted_at_idx")
  @@map("facilities")
}

model Customer {
  id             String                  @id(map: "customers_pkey") @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  customerCode   String                  @map("customer_code") @db.VarChar(40)
  type           CustomerType
  firstName      String?                 @map("first_name") @db.VarChar(120)
  lastName       String?                 @map("last_name") @db.VarChar(120)
  businessName   String?                 @map("business_name") @db.VarChar(200)
  email          String?                 @db.VarChar(320)
  phone          String?                 @db.VarChar(32)
  mobilePhone    String?                 @map("mobile_phone") @db.VarChar(32)
  status         CustomerStatus          @default(PENDING)
  notes          String?                 @db.VarChar(1000)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?               @map("deleted_at") @db.Timestamptz(3)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "customers_organization_id_fkey")
  addresses      CustomerAddress[]
  customsProfile CustomerCustomsProfile?

  @@unique([organizationId, customerCode], map: "customers_organization_id_customer_code_key")
  @@unique([organizationId, id], map: "customers_organization_id_id_key")
  @@index([organizationId, status], map: "customers_organization_id_status_idx")
  @@index([organizationId, type], map: "customers_organization_id_type_idx")
  @@index([organizationId, deletedAt], map: "customers_organization_id_deleted_at_idx")
  @@map("customers")
}

model CustomerAddress {
  id             String              @id(map: "customer_addresses_pkey") @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  customerId     String              @map("customer_id") @db.Uuid
  type           CustomerAddressType
  label          String?             @db.VarChar(120)
  recipientName  String?             @map("recipient_name") @db.VarChar(160)
  phone          String?             @db.VarChar(32)
  addressLine1   String              @map("address_line_1") @db.VarChar(200)
  addressLine2   String?             @map("address_line_2") @db.VarChar(200)
  city           String              @db.VarChar(80)
  province       String              @db.VarChar(80)
  postalCode     String?             @map("postal_code") @db.VarChar(32)
  countryCode    String              @default("DO") @map("country_code") @db.Char(2)
  isPrimary      Boolean             @default(false) @map("is_primary")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz(3)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "customer_addresses_organization_id_fkey")
  customer       Customer            @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "customer_addresses_organization_id_customer_id_fkey")

  @@unique([organizationId, id], map: "customer_addresses_organization_id_id_key")
  @@index([organizationId, customerId], map: "customer_addresses_organization_id_customer_id_idx")
  @@index([organizationId, customerId, type], map: "customer_addresses_organization_id_customer_id_type_idx")
  @@index([organizationId, deletedAt], map: "customer_addresses_organization_id_deleted_at_idx")
  @@map("customer_addresses")
}

model CustomerCustomsProfile {
  id                 String                       @id(map: "customer_customs_profiles_pkey") @default(uuid()) @db.Uuid
  organizationId     String                       @map("organization_id") @db.Uuid
  customerId         String                       @map("customer_id") @db.Uuid
  documentType       CustomerIdentityDocumentType @map("document_type")
  documentNumber     String                       @map("document_number") @db.VarChar(30)
  ruaStatus          CustomsRegistrationStatus    @default(UNKNOWN) @map("rua_status")
  verificationSource CustomsVerificationSource?   @map("verification_source")
  lastCheckedAt      DateTime?                    @map("last_checked_at") @db.Timestamptz(3)
  verifiedAt         DateTime?                    @map("verified_at") @db.Timestamptz(3)
  externalReference  String?                      @map("external_reference") @db.VarChar(120)
  notes              String?                      @db.VarChar(1000)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "customer_customs_profiles_organization_id_fkey")
  customer           Customer                     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "customer_customs_profiles_organization_id_customer_id_fkey")

  @@unique([organizationId, customerId], map: "customer_customs_profiles_organization_id_customer_id_key")
  @@unique([organizationId, documentType, documentNumber], map: "customer_customs_profiles_org_doc_key")
  @@unique([organizationId, id], map: "customer_customs_profiles_organization_id_id_key")
  @@index([organizationId, ruaStatus], map: "customer_customs_profiles_organization_id_rua_status_idx")
  @@map("customer_customs_profiles")
}

model User {
  id                  String                @id(map: "users_pkey") @default(uuid()) @db.Uuid
  email               String                @unique(map: "users_email_key") @db.VarChar(320)
  passwordHash        String?               @map("password_hash") @db.VarChar(255)
  passwordChangedAt   DateTime?             @map("password_changed_at") @db.Timestamptz(3)
  emailVerifiedAt     DateTime?             @map("email_verified_at") @db.Timestamptz(3)
  status              UserStatus            @default(INVITED)
  failedLoginAttempts Int                   @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?             @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?             @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?             @map("deleted_at") @db.Timestamptz(3)
  employees           Employee[]
  activationTokens    UserActivationToken[]
  loginChallenges     LoginChallenge[]

  @@index([status], map: "users_status_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

model UserActivationToken {
  id            String    @id(map: "user_activation_tokens_pkey") @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique(map: "user_activation_tokens_token_hash_key") @map("token_hash") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "user_activation_tokens_user_id_fkey")

  @@index([userId], map: "user_activation_tokens_user_id_idx")
  @@index([expiresAt], map: "user_activation_tokens_expires_at_idx")
  @@index([consumedAt], map: "user_activation_tokens_consumed_at_idx")
  @@index([invalidatedAt], map: "user_activation_tokens_invalidated_at_idx")
  @@map("user_activation_tokens")
}

model LoginChallenge {
  id            String    @id(map: "login_challenges_pkey") @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique(map: "login_challenges_token_hash_key") @map("token_hash") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "login_challenges_user_id_fkey")

  @@index([userId, expiresAt], map: "login_challenges_user_id_expires_at_idx")
  @@index([consumedAt], map: "login_challenges_consumed_at_idx")
  @@index([invalidatedAt], map: "login_challenges_invalidated_at_idx")
  @@map("login_challenges")
}

model Employee {
  id                 String             @id(map: "employees_pkey") @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  employeeCode       String?            @map("employee_code") @db.VarChar(40)
  firstName          String             @map("first_name") @db.VarChar(120)
  lastName           String             @map("last_name") @db.VarChar(120)
  phone              String?            @db.VarChar(32)
  status             EmployeeStatus     @default(PENDING)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(3)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employees_organization_id_fkey")
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employees_user_id_fkey")
  employeeFacilities EmployeeFacility[]
  employeeRoles      EmployeeRole[]
  userSessions       UserSession[]

  @@unique([organizationId, userId], map: "employees_organization_id_user_id_key")
  @@unique([organizationId, employeeCode], map: "employees_organization_id_employee_code_key")
  @@unique([organizationId, id], map: "employees_organization_id_id_key")
  @@index([organizationId, status], map: "employees_organization_id_status_idx")
  @@index([organizationId, deletedAt], map: "employees_organization_id_deleted_at_idx")
  @@index([userId], map: "employees_user_id_idx")
  @@map("employees")
}

model EmployeeFacility {
  id             String       @id(map: "employee_facilities_pkey") @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  facilityId     String       @map("facility_id") @db.Uuid
  isPrimary      Boolean      @default(false) @map("is_primary")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_facilities_organization_id_fkey")
  employee       Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "employee_facilities_organization_id_employee_id_fkey")
  facility       Facility     @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "employee_facilities_organization_id_facility_id_fkey")

  @@unique([organizationId, employeeId, facilityId], map: "employee_facilities_organization_id_employee_id_facility_id_key")
  @@index([organizationId, employeeId], map: "employee_facilities_organization_id_employee_id_idx")
  @@index([organizationId, facilityId], map: "employee_facilities_organization_id_facility_id_idx")
  @@map("employee_facilities")
}

model UserSession {
  id                   String                   @id(map: "user_sessions_pkey") @default(uuid()) @db.Uuid
  familyId             String                   @map("family_id") @db.Uuid
  organizationId       String                   @map("organization_id") @db.Uuid
  employeeId           String                   @map("employee_id") @db.Uuid
  tokenHash            String                   @unique(map: "user_sessions_token_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt            DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revocationReason     SessionRevocationReason? @map("revocation_reason")
  rotatedFromSessionId String?                  @map("rotated_from_session_id") @db.Uuid
  lastSeenAt           DateTime?                @map("last_seen_at") @db.Timestamptz(3)
  ipAddress            String?                  @map("ip_address") @db.VarChar(64)
  userAgent            String?                  @map("user_agent") @db.VarChar(512)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "user_sessions_organization_id_fkey")
  employee             Employee                 @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "user_sessions_organization_id_employee_id_fkey")
  rotatedFromSession   UserSession?             @relation("UserSessionRotation", fields: [familyId, rotatedFromSessionId], references: [familyId, id], onDelete: Restrict, onUpdate: Cascade, map: "user_sessions_family_id_rotated_from_session_id_fkey")
  rotatedToSessions    UserSession[]            @relation("UserSessionRotation")

  @@unique([familyId, id], map: "user_sessions_family_id_id_key")
  @@unique([rotatedFromSessionId], map: "user_sessions_rotated_from_session_id_key")
  @@index([familyId, revokedAt], map: "user_sessions_family_id_revoked_at_idx")
  @@index([organizationId, employeeId], map: "user_sessions_organization_id_employee_id_idx")
  @@index([organizationId, employeeId, revokedAt, expiresAt], map: "user_sessions_organization_id_employee_id_revoked_at_expires_at")
  @@index([expiresAt], map: "user_sessions_expires_at_idx")
  @@index([revokedAt], map: "user_sessions_revoked_at_idx")
  @@map("user_sessions")
}

model Role {
  id              String           @id(map: "roles_pkey") @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  code            String           @db.VarChar(50)
  name            String           @db.VarChar(120)
  description     String?          @db.VarChar(500)
  isSystem        Boolean          @default(false) @map("is_system")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "roles_organization_id_fkey")
  employeeRoles   EmployeeRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code], map: "roles_organization_id_code_key")
  @@unique([organizationId, id], map: "roles_organization_id_id_key")
  @@index([organizationId, isActive], map: "roles_organization_id_is_active_idx")
  @@index([organizationId, deletedAt], map: "roles_organization_id_deleted_at_idx")
  @@map("roles")
}

model Permission {
  id              String           @id(map: "permissions_pkey") @default(uuid()) @db.Uuid
  code            String           @unique(map: "permissions_code_key") @db.VarChar(120)
  name            String           @db.VarChar(160)
  description     String?          @db.VarChar(500)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rolePermissions RolePermission[]

  @@index([isActive], map: "permissions_is_active_idx")
  @@map("permissions")
}

model EmployeeRole {
  id             String       @id(map: "employee_roles_pkey") @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_roles_organization_id_fkey")
  employee       Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "employee_roles_organization_id_employee_id_fkey")
  role           Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "employee_roles_organization_id_role_id_fkey")

  @@unique([organizationId, employeeId, roleId], map: "employee_roles_organization_id_employee_id_role_id_key")
  @@index([organizationId, employeeId], map: "employee_roles_organization_id_employee_id_idx")
  @@index([organizationId, roleId], map: "employee_roles_organization_id_role_id_idx")
  @@map("employee_roles")
}

model RolePermission {
  id             String       @id(map: "role_permissions_pkey") @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  permissionId   String       @map("permission_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "role_permissions_organization_id_fkey")
  role           Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "role_permissions_organization_id_role_id_fkey")
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "role_permissions_permission_id_fkey")

  @@unique([organizationId, roleId, permissionId], map: "role_permissions_organization_id_role_id_permission_id_key")
  @@index([organizationId, roleId], map: "role_permissions_organization_id_role_id_idx")
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}
