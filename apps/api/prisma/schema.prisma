model Organization {
  id                        String                     @id(map: "organizations_pkey") @default(uuid()) @db.Uuid
  legalName                 String                     @map("legal_name") @db.VarChar(200)
  commercialName            String                     @map("commercial_name") @db.VarChar(120)
  slug                      String                     @unique(map: "organizations_slug_key") @db.VarChar(80)
  rnc                       String?                    @db.VarChar(20)
  email                     String?                    @db.VarChar(320)
  phone                     String?                    @db.VarChar(32)
  countryCode               String                     @default("DO") @map("country_code") @db.Char(2)
  currencyCode              String                     @default("DOP") @map("currency_code") @db.Char(3)
  timezone                  String                     @default("America/Santo_Domingo") @db.VarChar(64)
  status                    OrganizationStatus         @default(TRIAL)
  planCode                  String                     @default("PILOT") @map("plan_code") @db.VarChar(40)
  maxUsers                  Int                        @default(5) @map("max_users")
  maxFacilities             Int                        @default(2) @map("max_facilities")
  trialEndsAt               DateTime?                  @map("trial_ends_at") @db.Timestamptz(3)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                 DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  facilities                Facility[]
  customers                 Customer[]
  customerAddresses         CustomerAddress[]
  customerCustomsProfiles   CustomerCustomsProfile[]
  employees                 Employee[]
  employeeFacilities        EmployeeFacility[]
  roles                     Role[]
  employeeRoles             EmployeeRole[]
  rolePermissions           RolePermission[]
  userSessions              UserSession[]
  settings                  OrganizationSettings?
  customerImportJobs        CustomerImportJob[]
  customerImportRows        CustomerImportRow[]
  auditLogs                 AuditLog[]
  outboxEvents              OutboxEvent[]
  prealerts                 Prealert[]
  packages                  Package[]
  packageReceptions         PackageReception[]
  storedObjects             StoredObject[]
  packageDocuments          PackageDocument[]
  warehouseLocations        WarehouseLocation[]
  packageInventoryPositions PackageInventoryPosition[]
  inventoryMovements        InventoryMovement[]

  pickupRequests     PickupRequest[]
  pickupRequestItems PickupRequestItem[]
  courierServices    CourierService[]
  rateCards          RateCard[]
  rateRules          RateRule[]
  customerInvoices   CustomerInvoice[]
  invoiceLines       InvoiceLine[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]

  packageTrackingEvents  PackageTrackingEvent[]
  dispatches             Dispatch[]
  customsManifests       CustomsManifest[]
  houseShipments         HouseShipment[]
  houseShipmentPackages  HouseShipmentPackage[]
  customsCases           CustomsCase[]
  customsCaseEvents      CustomsCaseEvent[]
  operationalHolds       OperationalHold[]
  correctionRequests     CorrectionRequest[]
  correctionDecisions    CorrectionDecision[]
  facilityTransfers      FacilityTransfer[]
  facilityTransferItems  FacilityTransferItem[]
  facilityTransferEvents FacilityTransferEvent[]
  deliveryOrders         DeliveryOrder[]
  deliveryOrderItems     DeliveryOrderItem[]
  deliveryAttempts       DeliveryAttempt[]

  @@index([status], map: "organizations_status_idx")
  @@index([deletedAt], map: "organizations_deleted_at_idx")
  @@map("organizations")
}

model AuditLog {
  id              String         @id(map: "audit_logs_pkey") @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  actorType       AuditActorType @map("actor_type")
  actorUserId     String?        @map("actor_user_id") @db.Uuid
  actorEmployeeId String?        @map("actor_employee_id") @db.Uuid
  action          String         @db.VarChar(120)
  entityType      String         @map("entity_type") @db.VarChar(80)
  entityId        String         @map("entity_id") @db.VarChar(128)
  source          AuditSource
  requestId       String         @map("request_id") @db.Uuid
  correlationId   String         @map("correlation_id") @db.VarChar(100)
  changedFields   Json           @map("changed_fields")
  beforeData      Json?          @map("before_data")
  afterData       Json?          @map("after_data")
  reason          String?        @db.VarChar(500)
  metadata        Json?
  ipAddress       String?        @map("ip_address") @db.VarChar(64)
  userAgent       String?        @map("user_agent") @db.VarChar(512)
  occurredAt      DateTime       @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "audit_logs_organization_id_fkey")

  @@index([organizationId, occurredAt], map: "audit_logs_organization_id_occurred_at_idx")
  @@index([organizationId, entityType, entityId, occurredAt], map: "audit_logs_org_entity_occurred_at_idx")
  @@index([organizationId, actorEmployeeId, occurredAt], map: "audit_logs_org_actor_occurred_at_idx")
  @@index([organizationId, action, occurredAt], map: "audit_logs_org_action_occurred_at_idx")
  @@index([organizationId, correlationId], map: "audit_logs_org_correlation_id_idx")
  @@map("audit_logs")
}

model OutboxEvent {
  id                  String            @id(map: "outbox_events_pkey") @default(uuid()) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  eventType           String            @map("event_type") @db.VarChar(120)
  aggregateType       String            @map("aggregate_type") @db.VarChar(80)
  aggregateId         String            @map("aggregate_id") @db.VarChar(128)
  schemaVersion       Int               @map("schema_version")
  payload             Json
  metadata            Json?
  idempotencyKey      String            @map("idempotency_key") @db.VarChar(200)
  status              OutboxEventStatus @default(PENDING)
  occurredAt          DateTime          @map("occurred_at") @db.Timestamptz(3)
  availableAt         DateTime          @map("available_at") @db.Timestamptz(3)
  lockedBy            String?           @map("locked_by") @db.VarChar(120)
  lockedUntil         DateTime?         @map("locked_until") @db.Timestamptz(3)
  attempts            Int               @default(0)
  processingStartedAt DateTime?         @map("processing_started_at") @db.Timestamptz(3)
  publishedAt         DateTime?         @map("published_at") @db.Timestamptz(3)
  deadLetteredAt      DateTime?         @map("dead_lettered_at") @db.Timestamptz(3)
  lastErrorCode       String?           @map("last_error_code") @db.VarChar(120)
  lastErrorAt         DateTime?         @map("last_error_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "outbox_events_organization_id_fkey")

  @@unique([organizationId, idempotencyKey], map: "outbox_events_organization_id_idempotency_key_key")
  @@index([status, availableAt, createdAt], map: "outbox_events_status_available_at_created_at_idx")
  @@index([organizationId, aggregateType, aggregateId], map: "outbox_events_org_aggregate_idx")
  @@index([organizationId, occurredAt], map: "outbox_events_organization_id_occurred_at_idx")
  @@map("outbox_events")
}

model Facility {
  id                        String                     @id(map: "facilities_pkey") @default(uuid()) @db.Uuid
  organizationId            String                     @map("organization_id") @db.Uuid
  code                      String                     @db.VarChar(40)
  name                      String                     @db.VarChar(120)
  type                      FacilityType
  ownershipType             FacilityOwnershipType      @default(OWNED) @map("ownership_type")
  countryCode               String                     @default("DO") @map("country_code") @db.Char(2)
  province                  String?                    @db.VarChar(80)
  city                      String?                    @db.VarChar(80)
  addressLine1              String?                    @map("address_line_1") @db.VarChar(200)
  addressLine2              String?                    @map("address_line_2") @db.VarChar(200)
  phone                     String?                    @db.VarChar(32)
  email                     String?                    @db.VarChar(320)
  isCustomerFacing          Boolean                    @default(true) @map("is_customer_facing")
  isPackageOrigin           Boolean                    @default(false) @map("is_package_origin")
  isDistributionCenter      Boolean                    @default(false) @map("is_distribution_center")
  isActive                  Boolean                    @default(true) @map("is_active")
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                 DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "facilities_organization_id_fkey")
  employeeFacilities        EmployeeFacility[]
  packageReceptions         PackageReception[]
  warehouseLocations        WarehouseLocation[]
  packageInventoryPositions PackageInventoryPosition[]
  inventoryMovements        InventoryMovement[]

  pickupRequests       PickupRequest[]
  transfersOrigin      FacilityTransfer[] @relation("TransferOriginFacility")
  transfersDestination FacilityTransfer[] @relation("TransferDestinationFacility")

  @@unique([organizationId, code], map: "facilities_organization_id_code_key")
  @@unique([organizationId, id], map: "facilities_organization_id_id_key")
  @@index([organizationId, type], map: "facilities_organization_id_type_idx")
  @@index([organizationId, isActive], map: "facilities_organization_id_is_active_idx")
  @@index([organizationId, deletedAt], map: "facilities_organization_id_deleted_at_idx")
  @@map("facilities")
}

model Customer {
  id             String                  @id(map: "customers_pkey") @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  customerCode   String                  @map("customer_code") @db.VarChar(40)
  type           CustomerType
  firstName      String?                 @map("first_name") @db.VarChar(120)
  lastName       String?                 @map("last_name") @db.VarChar(120)
  businessName   String?                 @map("business_name") @db.VarChar(200)
  email          String?                 @db.VarChar(320)
  phone          String?                 @db.VarChar(32)
  mobilePhone    String?                 @map("mobile_phone") @db.VarChar(32)
  status         CustomerStatus          @default(PENDING)
  notes          String?                 @db.VarChar(1000)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?               @map("deleted_at") @db.Timestamptz(3)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "customers_organization_id_fkey")
  addresses      CustomerAddress[]
  customsProfile CustomerCustomsProfile?
  importRows     CustomerImportRow[]
  prealerts      Prealert[]
  packages       Package[]

  pickupRequests   PickupRequest[]
  customerInvoices CustomerInvoice[]
  payments         Payment[]
  deliveryOrders   DeliveryOrder[]

  @@unique([organizationId, customerCode], map: "customers_organization_id_customer_code_key")
  @@unique([organizationId, id], map: "customers_organization_id_id_key")
  @@index([organizationId, status], map: "customers_organization_id_status_idx")
  @@index([organizationId, type], map: "customers_organization_id_type_idx")
  @@index([organizationId, deletedAt], map: "customers_organization_id_deleted_at_idx")
  @@map("customers")
}

model OrganizationSettings {
  organizationId              String               @id(map: "organization_settings_pkey") @map("organization_id") @db.Uuid
  locale                      String               @default("es-DO") @db.VarChar(10)
  dateFormat                  DateDisplayFormat    @default(DMY) @map("date_format")
  weightUnit                  WeightUnit           @default(LB) @map("weight_unit")
  dimensionUnit               DimensionUnit        @default(IN) @map("dimension_unit")
  customerCodeStrategy        CustomerCodeStrategy @default(AUTO_RANDOM) @map("customer_code_strategy")
  customerCodePrefix          String               @default("C") @map("customer_code_prefix") @db.VarChar(8)
  customerCodeRandomLength    Int                  @default(8) @map("customer_code_random_length")
  customerCodeSequencePadding Int                  @default(6) @map("customer_code_sequence_padding")
  nextCustomerSequence        BigInt               @default(1) @map("next_customer_sequence") @db.BigInt
  onboardingCompletedAt       DateTime?            @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization                Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "organization_settings_organization_id_fkey")

  @@map("organization_settings")
}

enum RateCalculationType {
  FLAT
  PER_WEIGHT
  TIERED_WEIGHT
  PER_PIECE

  @@map("rate_calculation_type")
}

enum RateRuleStatus {
  DRAFT
  ACTIVE
  RETIRED

  @@map("rate_rule_status")
}

model CourierService {
  id             String       @id(map: "courier_services_pkey") @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(40)
  name           String       @db.VarChar(120)
  description    String?      @db.VarChar(500)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "courier_services_organization_id_fkey")
  rateCards      RateCard[]

  @@unique([organizationId, code], map: "courier_services_organization_id_code_key")
  @@unique([organizationId, id], map: "courier_services_organization_id_id_key")
  @@index([organizationId, isActive], map: "courier_services_organization_id_is_active_idx")
  @@map("courier_services")
}

model RateCard {
  id                 String              @id(map: "rate_cards_pkey") @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  serviceId          String              @map("service_id") @db.Uuid
  previousRateCardId String?             @map("previous_rate_card_id") @db.Uuid
  name               String              @db.VarChar(120)
  segmentKey         String              @map("segment_key") @db.VarChar(40)
  segmentName        String              @map("segment_name") @db.VarChar(120)
  calculationType    RateCalculationType @map("calculation_type")
  version            Int                 @default(1)
  status             RateRuleStatus      @default(DRAFT)
  currencyCode       String              @map("currency_code") @db.Char(3)
  weightUnit         WeightUnit          @map("weight_unit")
  effectiveFrom      DateTime?           @map("effective_from") @db.Timestamptz(3)
  effectiveTo        DateTime?           @map("effective_to") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "rate_cards_organization_id_fkey")
  service            CourierService      @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "rate_cards_organization_id_service_id_fkey")
  previousRateCard   RateCard?           @relation("RateCardVersionChain", fields: [organizationId, previousRateCardId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "rate_cards_previous_rate_card_id_fkey")
  nextVersions       RateCard[]          @relation("RateCardVersionChain")
  rules              RateRule[]

  @@unique([organizationId, id], map: "rate_cards_organization_id_id_key")
  @@unique([organizationId, serviceId, segmentKey, version], map: "rate_cards_org_service_segment_version_key")
  @@index([organizationId, serviceId, status], map: "rate_cards_organization_id_service_id_status_idx")
  @@index([organizationId, serviceId, segmentKey, status], map: "rate_cards_org_service_segment_status_idx")
  @@index([organizationId, previousRateCardId], map: "rate_cards_organization_id_previous_rate_card_id_idx")
  @@map("rate_cards")
}

model RateRule {
  id              String       @id(map: "rate_rules_pkey") @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  rateCardId      String       @map("rate_card_id") @db.Uuid
  sortOrder       Int          @map("sort_order")
  minWeight       Decimal?     @map("min_weight") @db.Decimal(12, 3)
  maxWeight       Decimal?     @map("max_weight") @db.Decimal(12, 3)
  flatAmountMinor BigInt?      @map("flat_amount_minor") @db.BigInt
  unitAmountMinor BigInt?      @map("unit_amount_minor") @db.BigInt
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "rate_rules_organization_id_fkey")
  rateCard        RateCard     @relation(fields: [organizationId, rateCardId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade, map: "rate_rules_organization_id_rate_card_id_fkey")

  @@unique([organizationId, id], map: "rate_rules_organization_id_id_key")
  @@unique([organizationId, rateCardId, sortOrder], map: "rate_rules_org_rate_card_sort_order_key")
  @@index([organizationId, rateCardId], map: "rate_rules_organization_id_rate_card_id_idx")
  @@map("rate_rules")
}

model CustomerImportJob {
  id                    String                  @id(map: "customer_import_jobs_pkey") @default(uuid()) @db.Uuid
  organizationId        String                  @map("organization_id") @db.Uuid
  createdByEmployeeId   String                  @map("created_by_employee_id") @db.Uuid
  name                  String?                 @db.VarChar(160)
  status                CustomerImportJobStatus
  preserveCustomerCodes Boolean                 @default(false) @map("preserve_customer_codes")
  totalRows             Int                     @default(0) @map("total_rows")
  validRows             Int                     @default(0) @map("valid_rows")
  invalidRows           Int                     @default(0) @map("invalid_rows")
  importedRows          Int                     @default(0) @map("imported_rows")
  validationSummary     Json?                   @map("validation_summary")
  failureCode           String?                 @map("failure_code") @db.VarChar(80)
  validatedAt           DateTime?               @map("validated_at") @db.Timestamptz(3)
  startedAt             DateTime?               @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?               @map("completed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?               @map("cancelled_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "customer_import_jobs_organization_id_fkey")
  createdByEmployee     Employee                @relation(fields: [organizationId, createdByEmployeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "customer_import_jobs_created_by_employee_fkey")
  rows                  CustomerImportRow[]

  @@unique([organizationId, id], map: "customer_import_jobs_organization_id_id_key")
  @@index([organizationId, status], map: "customer_import_jobs_organization_id_status_idx")
  @@index([organizationId, createdByEmployeeId], map: "customer_import_jobs_organization_id_created_by_employee_id_idx")
  @@map("customer_import_jobs")
}

model CustomerImportRow {
  id                 String                  @id(map: "customer_import_rows_pkey") @default(uuid()) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  importJobId        String                  @map("import_job_id") @db.Uuid
