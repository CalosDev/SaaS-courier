  organizationId String                @map("organization_id") @db.Uuid
  deliveryId     String                @map("delivery_id") @db.Uuid
  attemptedAt    DateTime              @map("attempted_at") @db.Timestamptz(3)
  result         DeliveryAttemptResult
  notes          String?               @db.VarChar(1000)
  receiverName   String?               @map("receiver_name") @db.VarChar(120)
  recordedById   String                @map("recorded_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "delivery_attempts_org_id_fkey")
  delivery     DeliveryOrder @relation(fields: [organizationId, deliveryId], references: [organizationId, id], onDelete: Cascade, onUpdate: Cascade, map: "delivery_attempts_org_delivery_fkey")
  recordedBy   Employee      @relation("DeliveryAttemptRecordedBy", fields: [organizationId, recordedById], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "delivery_attempts_recorded_by_fkey")

  @@unique([organizationId, id], map: "delivery_attempts_org_id_key")
  @@index([organizationId, deliveryId], map: "delivery_attempts_org_delivery_idx")
  @@map("delivery_attempts")
}
