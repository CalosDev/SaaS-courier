  @@index([userId, expiresAt], map: "login_challenges_user_id_expires_at_idx")
  @@index([consumedAt], map: "login_challenges_consumed_at_idx")
  @@index([invalidatedAt], map: "login_challenges_invalidated_at_idx")
  @@map("login_challenges")
}

model Employee {
  id                      String              @id(map: "employees_pkey") @default(uuid()) @db.Uuid
  organizationId          String              @map("organization_id") @db.Uuid
  userId                  String              @map("user_id") @db.Uuid
  employeeCode            String?             @map("employee_code") @db.VarChar(40)
  firstName               String              @map("first_name") @db.VarChar(120)
  lastName                String              @map("last_name") @db.VarChar(120)
  phone                   String?             @db.VarChar(32)
  status                  EmployeeStatus      @default(PENDING)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?           @map("deleted_at") @db.Timestamptz(3)
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employees_organization_id_fkey")
  user                    User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employees_user_id_fkey")
  employeeFacilities      EmployeeFacility[]
  employeeRoles           EmployeeRole[]
  userSessions            UserSession[]
  customerImportJobs      CustomerImportJob[]
  createdPrealerts        Prealert[]          @relation("PrealertCreatedByEmployee")
  cancelledPrealerts      Prealert[]          @relation("PrealertCancelledByEmployee")
  registeredPackages      Package[]           @relation("PackageRegisteredByEmployee")
  cancelledPackages       Package[]           @relation("PackageCancelledByEmployee")
  receivedPackages        PackageReception[]  @relation("PackageReceptionReceivedByEmployee")
  createdStoredObjects    StoredObject[]      @relation("StoredObjectCreatedByEmployee")
  createdPackageDocuments PackageDocument[]   @relation("PackageDocumentCreatedByEmployee")
  deletedPackageDocuments PackageDocument[]   @relation("PackageDocumentDeletedByEmployee")
  inventoryMovements      InventoryMovement[] @relation("InventoryMovementMovedByEmployee")

  requestedPickupRequests PickupRequest[] @relation("PickupRequestRequestedBy")
  completedPickupRequests PickupRequest[] @relation("PickupRequestCompletedBy")
  cancelledPickupRequests PickupRequest[] @relation("PickupRequestCancelledBy")

  createdTrackingEvents PackageTrackingEvent[]

  requestedHolds              OperationalHold[]  @relation("HoldRequestedBy")
  releasedHolds               OperationalHold[]  @relation("HoldReleasedBy")
  createdFacilityTransfers    FacilityTransfer[] @relation("TransferCreatedByEmployee")
  dispatchedFacilityTransfers FacilityTransfer[] @relation("TransferDispatchedByEmployee")
  receivedFacilityTransfers   FacilityTransfer[] @relation("TransferReceivedByEmployee")

  requestedCorrections CorrectionRequest[]  @relation("CorrectionRequestedBy")
  decidedCorrections   CorrectionDecision[] @relation("CorrectionDecidedBy")

  createdDeliveryOrders  DeliveryOrder[]   @relation("DeliveryCreatedBy")
  assignedDeliveryOrders DeliveryOrder[]   @relation("DeliveryAssignedTo")
  recordedDeliveryAttempts DeliveryAttempt[] @relation("DeliveryAttemptRecordedBy")

  @@unique([organizationId, userId], map: "employees_organization_id_user_id_key")
  @@unique([organizationId, employeeCode], map: "employees_organization_id_employee_code_key")
  @@unique([organizationId, id], map: "employees_organization_id_id_key")
  @@index([organizationId, status], map: "employees_organization_id_status_idx")
  @@index([organizationId, deletedAt], map: "employees_organization_id_deleted_at_idx")
  @@index([userId], map: "employees_user_id_idx")
  @@map("employees")
}

model EmployeeFacility {
  id             String       @id(map: "employee_facilities_pkey") @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  facilityId     String       @map("facility_id") @db.Uuid
  isPrimary      Boolean      @default(false) @map("is_primary")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_facilities_organization_id_fkey")
  employee       Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "employee_facilities_organization_id_employee_id_fkey")
  facility       Facility     @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "employee_facilities_organization_id_facility_id_fkey")

  @@unique([organizationId, employeeId, facilityId], map: "employee_facilities_organization_id_employee_id_facility_id_key")
  @@index([organizationId, employeeId], map: "employee_facilities_organization_id_employee_id_idx")
  @@index([organizationId, facilityId], map: "employee_facilities_organization_id_facility_id_idx")
  @@map("employee_facilities")
}

model Prealert {
  id                               String                @id(map: "prealerts_pkey") @default(uuid()) @db.Uuid
  organizationId                   String                @map("organization_id") @db.Uuid
  customerId                       String                @map("customer_id") @db.Uuid
  createdByEmployeeId              String                @map("created_by_employee_id") @db.Uuid
  prealertCode                     String                @map("prealert_code") @db.VarChar(20)
  externalTrackingNumber           String                @map("external_tracking_number") @db.VarChar(100)
  externalTrackingNumberNormalized String                @map("external_tracking_number_normalized") @db.VarChar(100)
  carrierName                      String?               @map("carrier_name") @db.VarChar(100)
  storeName                        String                @map("store_name") @db.VarChar(160)
  purchaseDate                     DateTime?             @map("purchase_date") @db.Date
  description                      String                @db.VarChar(500)
  quantity                         Int
  declaredValue                    Decimal               @map("declared_value") @db.Decimal(14, 2)
  currencyCode                     String                @map("currency_code") @db.Char(3)
  invoiceStatus                    PrealertInvoiceStatus @default(PENDING) @map("invoice_status")
  status                           PrealertStatus        @default(PENDING_ARRIVAL)
  notes                            String?               @db.VarChar(1000)
  cancellationReason               String?               @map("cancellation_reason") @db.VarChar(500)
  cancelledAt                      DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledByEmployeeId            String?               @map("cancelled_by_employee_id") @db.Uuid
  createdAt                        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                        DateTime?             @map("deleted_at") @db.Timestamptz(3)
  organization                     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "prealerts_organization_id_fkey")
  customer                         Customer              @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "prealerts_organization_id_customer_id_fkey")
  createdByEmployee                Employee              @relation("PrealertCreatedByEmployee", fields: [organizationId, createdByEmployeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "prealerts_organization_id_created_by_employee_id_fkey")
  cancelledByEmployee              Employee?             @relation("PrealertCancelledByEmployee", fields: [organizationId, cancelledByEmployeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "prealerts_organization_id_cancelled_by_employee_id_fkey")
  packages                         Package[]             @relation("PackagePrealert")

  @@unique([organizationId, prealertCode], map: "prealerts_organization_id_prealert_code_key")
  @@unique([organizationId, id], map: "prealerts_organization_id_id_key")
  @@index([organizationId, customerId], map: "prealerts_organization_id_customer_id_idx")
  @@index([organizationId, status, createdAt], map: "prealerts_organization_id_status_created_at_idx")
  @@index([organizationId, invoiceStatus, createdAt], map: "prealerts_organization_id_invoice_status_created_at_idx")
  @@index([organizationId, createdByEmployeeId], map: "prealerts_organization_id_created_by_employee_id_idx")
  @@index([organizationId, cancelledByEmployeeId], map: "prealerts_organization_id_cancelled_by_employee_id_idx")
  @@index([organizationId, externalTrackingNumberNormalized], map: "prealerts_organization_id_tracking_normalized_idx")
  @@index([organizationId, deletedAt], map: "prealerts_organization_id_deleted_at_idx")
  @@map("prealerts")
}

model Dispatch {
  id                   String          @id(map: "dispatches_pkey") @default(uuid()) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  dispatchCode         String          @map("dispatch_code") @db.VarChar(40)
  status               DispatchStatus  @default(DRAFT)
  origin               String?         @db.VarChar(120)
  destination          String?         @db.VarChar(120)
  carrier              String?         @db.VarChar(120)
  flightNumber         String?         @map("flight_number") @db.VarChar(40)
  departureTime        DateTime?       @map("departure_time") @db.Timestamptz(3)
  estimatedArrivalTime DateTime?       @map("estimated_arrival_time") @db.Timestamptz(3)
  actualArrivalTime    DateTime?       @map("actual_arrival_time") @db.Timestamptz(3)
