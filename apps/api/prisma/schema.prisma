  @@index([organizationId, toLocationId, occurredAt], map: "inventory_movements_org_to_location_occurred_idx")
  @@map("inventory_movements")
}

model UserSession {
  id                   String                   @id(map: "user_sessions_pkey") @default(uuid()) @db.Uuid
  familyId             String                   @map("family_id") @db.Uuid
  organizationId       String                   @map("organization_id") @db.Uuid
  employeeId           String                   @map("employee_id") @db.Uuid
  tokenHash            String                   @unique(map: "user_sessions_token_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt            DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revocationReason     SessionRevocationReason? @map("revocation_reason")
  rotatedFromSessionId String?                  @map("rotated_from_session_id") @db.Uuid
  lastSeenAt           DateTime?                @map("last_seen_at") @db.Timestamptz(3)
  ipAddress            String?                  @map("ip_address") @db.VarChar(64)
  userAgent            String?                  @map("user_agent") @db.VarChar(512)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "user_sessions_organization_id_fkey")
  employee             Employee                 @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "user_sessions_organization_id_employee_id_fkey")
  rotatedFromSession   UserSession?             @relation("UserSessionRotation", fields: [familyId, rotatedFromSessionId], references: [familyId, id], onDelete: Restrict, onUpdate: Cascade, map: "user_sessions_family_id_rotated_from_session_id_fkey")
  rotatedToSessions    UserSession[]            @relation("UserSessionRotation")

  @@unique([familyId, id], map: "user_sessions_family_id_id_key")
  @@unique([rotatedFromSessionId], map: "user_sessions_rotated_from_session_id_key")
  @@index([familyId, revokedAt], map: "user_sessions_family_id_revoked_at_idx")
  @@index([organizationId, employeeId], map: "user_sessions_organization_id_employee_id_idx")
  @@index([organizationId, employeeId, revokedAt, expiresAt], map: "user_sessions_organization_id_employee_id_revoked_at_expires_at")
  @@index([expiresAt], map: "user_sessions_expires_at_idx")
  @@index([revokedAt], map: "user_sessions_revoked_at_idx")
  @@map("user_sessions")
}

model Role {
  id              String           @id(map: "roles_pkey") @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  code            String           @db.VarChar(50)
  name            String           @db.VarChar(120)
  description     String?          @db.VarChar(500)
  isSystem        Boolean          @default(false) @map("is_system")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "roles_organization_id_fkey")
  employeeRoles   EmployeeRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code], map: "roles_organization_id_code_key")
  @@unique([organizationId, id], map: "roles_organization_id_id_key")
  @@index([organizationId, isActive], map: "roles_organization_id_is_active_idx")
  @@index([organizationId, deletedAt], map: "roles_organization_id_deleted_at_idx")
  @@map("roles")
}

model Permission {
  id              String           @id(map: "permissions_pkey") @default(uuid()) @db.Uuid
  code            String           @unique(map: "permissions_code_key") @db.VarChar(120)
  name            String           @db.VarChar(160)
  description     String?          @db.VarChar(500)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rolePermissions RolePermission[]

  @@index([isActive], map: "permissions_is_active_idx")
  @@map("permissions")
}

model EmployeeRole {
  id             String       @id(map: "employee_roles_pkey") @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_roles_organization_id_fkey")
  employee       Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "employee_roles_organization_id_employee_id_fkey")
  role           Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "employee_roles_organization_id_role_id_fkey")

  @@unique([organizationId, employeeId, roleId], map: "employee_roles_organization_id_employee_id_role_id_key")
  @@index([organizationId, employeeId], map: "employee_roles_organization_id_employee_id_idx")
  @@index([organizationId, roleId], map: "employee_roles_organization_id_role_id_idx")
  @@map("employee_roles")
}

model RolePermission {
  id             String       @id(map: "role_permissions_pkey") @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  permissionId   String       @map("permission_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "role_permissions_organization_id_fkey")
  role           Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Cascade, map: "role_permissions_organization_id_role_id_fkey")
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "role_permissions_permission_id_fkey")

  @@unique([organizationId, roleId, permissionId], map: "role_permissions_organization_id_role_id_permission_id_key")
  @@index([organizationId, roleId], map: "role_permissions_organization_id_role_id_idx")
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}
