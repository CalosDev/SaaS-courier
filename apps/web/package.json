{
  "name": "@courier/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"const fs=require('node:fs');fs.rmSync('.next/dev/types',{recursive:true,force:true});\" && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && node -e \"const fs=require('node:fs');fs.rmSync('.next/dev/types',{recursive:true,force:true});\" && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "lucide-react": "^0.554.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "swr": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^10",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vitest": "^4.1.10"
  }
}
